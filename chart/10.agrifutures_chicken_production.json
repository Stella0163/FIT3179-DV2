{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australian Chicken Meat Production by State",
    "subtitle": "2023–24 production volume",
    "fontSize": 18,
    "anchor": "start"
  },

  "width": 600,
  "height": 450,

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 650
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "../data/10.agrifutures_chicken_production.json"
      },

      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "production_tonnes",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "scale": {
            "range": [400, 5000]
          }
        },

        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "production_tonnes",
            "type": "quantitative",
            "title": "Production",
            "format": ","
          }
        ]
      }
    }
  ]
}