{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australian Chicken Meat Production by State",
    "subtitle": "2023–24 production volume. SA, WA and TAS are reported as a combined total.",
    "fontSize": 18,
    "subtitleFontSize": 11,
    "anchor": "start"
  },

  "width": 700,
  "height": 500,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#e6e6e6",
        "stroke": "white",
        "strokeWidth": 1.2
      },

      "encoding": {
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State/Territory"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "New South Wales",
                  "production_tonnes": 537000
                },
                {
                  "state": "Victoria",
                  "production_tonnes": 276000
                },
                {
                  "state": "Queensland",
                  "production_tonnes": 260000
                }
              ]
            },
            "key": "state",
            "fields": [
              "production_tonnes"
            ]
          }
        },
        {
          "filter": "isValid(datum.production_tonnes)"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2
      },

      "encoding": {
        "color": {
          "field": "production_tonnes",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "scale": {
            "scheme": "oranges"
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "production_tonnes",
            "type": "quantitative",
            "title": "Production (tonnes)",
            "format": ","
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 115,
            "latitude": -42,
            "note": "SA + WA + TAS combined: 377,000 tonnes"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontWeight": "bold"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "note"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}