{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australia Egg Production by State, 2026",
    "subtitle": "Share of national egg production by major producing states",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "anchor": "start"
  },

  "data": {
    "values": [
      {
        "state": "New South Wales",
        "state_code": "NSW",
        "share": 35
      },
      {
        "state": "Victoria",
        "state_code": "VIC",
        "share": 28
      },
      {
        "state": "Queensland",
        "state_code": "QLD",
        "share": 18
      },
      {
        "state": "Other States",
        "state_code": "OTHER",
        "share": 19
      }
    ]
  },

  "vconcat": [
    {
      "width": 500,
      "height": 420,

      "title": {
        "text": "Distribution of National Egg Production",
        "fontSize": 15
      },

      "layer": [
        {
          "mark": {
            "type": "arc",
            "innerRadius": 55,
            "stroke": "white",
            "strokeWidth": 2,
            "cornerRadius": 5
          },

          "encoding": {
            "theta": {
              "field": "state_code",
              "type": "nominal",
              "sort": [
                "NSW",
                "VIC",
                "QLD",
                "OTHER"
              ]
            },

            "radius": {
              "field": "share",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "zero": true,
                "rangeMin": 70,
                "rangeMax": 180
              }
            },

            "color": {
              "field": "state",
              "type": "nominal",
              "title": "State / Group",
              "scale": {
                "scheme": "blues"
              }
            },

            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "share",
                "type": "quantitative",
                "title": "Production Share (%)",
                "format": ".0f"
              }
            ]
          }
        },

        {
          "mark": {
            "type": "text",
            "radiusOffset": 22,
            "fontSize": 12,
            "fontWeight": "bold"
          },

          "encoding": {
            "theta": {
              "field": "state_code",
              "type": "nominal",
              "sort": [
                "NSW",
                "VIC",
                "QLD",
                "OTHER"
              ]
            },

            "radius": {
              "field": "share",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "zero": true,
                "rangeMin": 70,
                "rangeMax": 180
              }
            },

            "text": {
              "field": "state_code",
              "type": "nominal"
            }
          }
        }
      ]
    },

    {
      "width": 700,
      "height": 200,

      "title": {
        "text": "State Comparison",
        "fontSize": 15
      },

      "encoding": {
        "x": {
          "field": "state_code",
          "type": "nominal",
          "title": "State / Group",
          "sort": [
            "NSW",
            "VIC",
            "QLD",
            "OTHER"
          ],
          "axis": {
            "labelAngle": 0
          }
        },

        "y": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of National Egg Production (%)",
          "scale": {
            "domain": [
              0,
              40
            ]
          }
        },

        "color": {
          "field": "share",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "scheme": "blues"
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Production Share (%)",
            "format": ".0f"
          }
        ]
      },

      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusTopLeft": 5,
            "cornerRadiusTopRight": 5
          }
        },

        {
          "mark": {
            "type": "text",
            "dy": -9,
            "fontSize": 13,
            "fontWeight": "bold"
          },

          "encoding": {
            "text": {
              "field": "share",
              "type": "quantitative",
              "format": ".0f"
            }
          }
        }
      ]
    }
  ],

  "spacing": 30,

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },

    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}