{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australia Egg Production by State, 2026",
    "subtitle": "Share of national egg production by major producing states",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "anchor": "start",
    "offset": 16
  },

  "data": {
    "values": [
      {
        "state": "New South Wales",
        "state_code": "NSW",
        "share": 35
      },
      {
        "state": "Victoria",
        "state_code": "VIC",
        "share": 28
      },
      {
        "state": "Queensland",
        "state_code": "QLD",
        "share": 18
      },
      {
        "state": "Other States",
        "state_code": "OTHER",
        "share": 19
      }
    ]
  },

  "vconcat": [
    {
      "width": 600,
      "height": 430,

      "title": {
        "text": "Distribution of National Egg Production",
        "fontSize": 18,
        "anchor": "middle"
      },

      "layer": [
        {
          "params": [
            {
              "name": "stateSelect",
              "select": {
                "type": "point",
                "fields": ["state_code"],
                "on": "click",
                "toggle": "true",
                "clear": false
              }
            }
          ],

          "mark": {
            "type": "arc",
            "innerRadius": 55,
            "stroke": "white",
            "strokeWidth": 2,
            "cornerRadius": 5,
            "cursor": "pointer"
          },

          "encoding": {
            "theta": {
              "field": "state_code",
              "type": "nominal",
              "sort": [
                "NSW",
                "VIC",
                "QLD",
                "OTHER"
              ]
            },

            "radius": {
              "field": "share",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "zero": true,
                "rangeMin": 70,
                "rangeMax": 180
              }
            },

            "color": {
              "field": "state",
              "type": "nominal",
              "title": "State / Group",

              "scale": {
                "domain": [
                  "New South Wales",
                  "Victoria",
                  "Queensland",
                  "Other States"
                ],

                "range": [
                  "#1f4e79",
                  "#4f81bd",
                  "#87b5dc",
                  "#c9dced"
                ]
              },

              "legend": {
                "orient": "right",
                "titleFontSize": 14,
                "labelFontSize": 13,
                "symbolSize": 180,
                "offset": 18
              }
            },

            "opacity": {
              "condition": {
                "param": "stateSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.2
            },

            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "share",
                "type": "quantitative",
                "title": "Production Share (%)",
                "format": ".0f"
              }
            ]
          }
        },

        {
          "mark": {
            "type": "text",
            "radiusOffset": 24,
            "fontSize": 13,
            "fontWeight": "bold"
          },

          "encoding": {
            "theta": {
              "field": "state_code",
              "type": "nominal",
              "sort": [
                "NSW",
                "VIC",
                "QLD",
                "OTHER"
              ]
            },

            "radius": {
              "field": "share",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "zero": true,
                "rangeMin": 70,
                "rangeMax": 180
              }
            },

            "text": {
              "field": "state_code",
              "type": "nominal"
            },

            "opacity": {
              "condition": {
                "param": "stateSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.25
            }
          }
        }
      ]
    },

    {
      "width": 700,
      "height": 240,

      "title": {
        "text": "State Comparison",
        "fontSize": 18,
        "anchor": "middle"
      },

      "encoding": {
        "x": {
          "field": "state_code",
          "type": "nominal",
          "title": "State / Group",

          "sort": [
            "NSW",
            "VIC",
            "QLD",
            "OTHER"
          ],

          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "labelPadding": 8
          }
        },

        "y": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of National Egg Production (%)",

          "scale": {
            "domain": [
              0,
              40
            ]
          },

          "axis": {
            "labelFontSize": 13,
            "titleFontSize": 14,
            "gridColor": "#e5e7eb"
          }
        },

        "color": {
          "field": "state",
          "type": "nominal",

          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "Other States"
            ],

            "range": [
              "#1f4e79",
              "#4f81bd",
              "#87b5dc",
              "#c9dced"
            ]
          },

          "legend": null
        },

        "opacity": {
          "condition": {
            "param": "stateSelect",
            "value": 1,
            "empty": true
          },
          "value": 0.2
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Production Share (%)",
            "format": ".0f"
          }
        ]
      },

      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusTopLeft": 6,
            "cornerRadiusTopRight": 6
          }
        },

        {
          "mark": {
            "type": "text",
            "dy": -10,
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#1f2a2e"
          },

          "encoding": {
            "text": {
              "field": "share",
              "type": "quantitative",
              "format": ".0f"
            }
          }
        },

        {
          "mark": {
            "type": "text",
            "dy": -28,
            "fontSize": 12,
            "color": "#4b5563"
          },

          "encoding": {
            "text": {
              "value": "%"
            }
          }
        }
      ]
    }
  ],

  "spacing": 36,

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },

    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}