{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australia Egg Production by State 2026",
    "subtitle": "NSW, Victoria and Queensland are shown individually; remaining states are grouped as 'Other States'.",
    "fontSize": 20,
    "subtitleFontSize": 12
  },

  "vconcat": [
    {
      "width": 700,
      "height": 430,

      "projection": {
        "type": "mercator",
        "center": [134, -28],
        "scale": 620
      },

      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#eeeeee",
            "stroke": "white",
            "strokeWidth": 1.2
          }
        },

        {
          "data": {
            "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "transform": [
            {
              "calculate": "datum.properties.STATE_NAME",
              "as": "state"
            },
            {
              "lookup": "state",
              "from": {
                "data": {
                  "values": [
                    {
                      "state": "New South Wales",
                      "state_code": "NSW",
                      "share_of_national_production_percent": 35
                    },
                    {
                      "state": "Victoria",
                      "state_code": "VIC",
                      "share_of_national_production_percent": 28
                    },
                    {
                      "state": "Queensland",
                      "state_code": "QLD",
                      "share_of_national_production_percent": 18
                    }
                  ]
                },
                "key": "state",
                "fields": [
                  "state_code",
                  "share_of_national_production_percent"
                ]
              }
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 1.2
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "datum.share_of_national_production_percent != null",
                "field": "share_of_national_production_percent",
                "type": "quantitative",
                "title": "Share of National Production (%)",
                "scale": {
                  "scheme": "blues"
                }
              },
              "value": "#d9d9d9"
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "share_of_national_production_percent",
                "type": "quantitative",
                "title": "Production Share (%)",
                "format": ".0f"
              }
            ]
          }
        },

        {
          "data": {
            "values": [
              {
                "state_code": "QLD",
                "share": 18,
                "lon": 145,
                "lat": -20,
                "label": "QLD 18%"
              },
              {
                "state_code": "NSW",
                "share": 35,
                "lon": 147,
                "lat": -33,
                "label": "NSW 35%"
              },
              {
                "state_code": "VIC",
                "share": 28,
                "lon": 145,
                "lat": -37,
                "label": "VIC 28%"
              },
              {
                "state_code": "OTHER",
                "share": 19,
                "lon": 121,
                "lat": -27,
                "label": "Other states combined: 19%"
              }
            ]
          },
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "black"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        }
      ]
    },

    {
      "width": 700,
      "height": 180,

      "data": {
        "values": [
          {
            "state": "New South Wales",
            "state_code": "NSW",
            "share_of_national_production_percent": 35
          },
          {
            "state": "Victoria",
            "state_code": "VIC",
            "share_of_national_production_percent": 28
          },
          {
            "state": "Queensland",
            "state_code": "QLD",
            "share_of_national_production_percent": 18
          },
          {
            "state": "Other States",
            "state_code": "OTHER",
            "share_of_national_production_percent": 19
          }
        ]
      },

      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },

      "encoding": {
        "x": {
          "field": "state_code",
          "type": "nominal",
          "title": "State / Group",
          "sort": ["NSW", "VIC", "QLD", "OTHER"]
        },
        "y": {
          "field": "share_of_national_production_percent",
          "type": "quantitative",
          "title": "Share of National Egg Production (%)"
        },
        "color": {
          "field": "share_of_national_production_percent",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "scheme": "blues"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share_of_national_production_percent",
            "type": "quantitative",
            "title": "Production Share (%)",
            "format": ".0f"
          }
        ]
      },

      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusTopLeft": 4,
            "cornerRadiusTopRight": 4
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -8,
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "encoding": {
            "text": {
              "field": "share_of_national_production_percent",
              "type": "quantitative",
              "format": ".0f"
            }
          }
        }
      ]
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}